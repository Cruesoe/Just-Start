<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Randy's Choice - one to five colonists; tile, biome, arrival method, season, xenotype and
    ideoligion are all rolled at random. Gear and clothes are whatever vanilla generation gives.
    Demonstrates: allowAnyBiome, a countRange role, and randomised arrival/season/ideology options.
  -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>JustStart_Randy</defName>
    <label>Randy&apos;s Choice</label>
    <description>You get what you&apos;re given. Where you land, when you arrive, who you are and what you believe: all left to chance.</description>
    <scenario>
      <summary>One to five colonists. Everything else is random.</summary>
      <name>Randy&apos;s Choice</name>
      <parts>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>You get what you're given: a place, a season, a handful of people, and whatever they happen to believe.\n\nNone of it was your choice. All of it is now your problem.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
    <modExtensions>
      <li Class="JustStart.JustStartScenarioExtension">
        <allowAnyBiome>true</allowAnyBiome>
        <arrivalMethods>
          <li>Standing</li>
          <li>DropPods</li>
        </arrivalMethods>
        <startingSeasons>
          <li>Spring</li>
          <li>Summer</li>
          <li>Fall</li>
          <li>Winter</li>
        </startingSeasons>
        <pawnRoles>
          <li>
            <id>randy</id>
            <countRange>1~5</countRange>
            <faction>PlayerColonist</faction>
            <xenotypeRules>
              <mode>Random</mode>
            </xenotypeRules>
          </li>
        </pawnRoles>
        <ideologyRules>
          <modes>
            <li>Fixed</li>
            <li>Fluid</li>
          </modes>
        </ideologyRules>
      </li>
    </modExtensions>
  </ScenarioDef>

</Defs>
