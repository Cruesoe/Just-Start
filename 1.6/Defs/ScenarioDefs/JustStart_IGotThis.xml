<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    I Got This - one colonist, one revolver, a forced Sea Ice landing.
    Demonstrates: an exact biome restriction, and a fixed (non-vanilla) starting loadout.
  -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>JustStart_IGotThis</defName>
    <label>I Got This</label>
    <description>One person. One pistol. The ice does not care.</description>
    <scenario>
      <summary>One colonist, one revolver, sea ice.</summary>
      <name>I Got This</name>
      <parts>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>You asked for the hardest drop they had. They gave you sea ice, a revolver, and nothing else.\n\nThe cold does not negotiate.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
    <modExtensions>
      <li Class="JustStart.JustStartScenarioExtension">
        <tileConstraints>
          <li Class="JustStart.TileConstraint_Biome">
            <allowedBiomes>
              <li>SeaIce</li>
            </allowedBiomes>
          </li>
        </tileConstraints>
        <pawnRoles>
          <li>
            <id>lone_survivor</id>
            <count>1</count>
            <faction>PlayerColonist</faction>
            <useDefaultVanillaGear>false</useDefaultVanillaGear>
            <fixedEquipment>
              <Gun_Revolver>1</Gun_Revolver>
            </fixedEquipment>
          </li>
        </pawnRoles>
      </li>
    </modExtensions>
  </ScenarioDef>

</Defs>
