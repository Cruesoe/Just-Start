<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The Prisoner - an escaped colonist in basic clothes with a pistol lying nearby, and a hostile
    melee guard further off who fights to the death. Reach the pistol first and kite the guard.
    Demonstrates: multiple pawn roles (colonist + HostileOnMap) and a map item to find.
    Uses a spacer player faction if VFE - Deserters or Progression: Scenarios is loaded, industrial otherwise.
  -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>JustStart_ThePrisoner</defName>
    <label>The Prisoner</label>
    <description>You got out. The guard who was watching your cell is still out there, and armed.</description>
    <scenario>
      <summary>One escaped prisoner with nothing, and an armed guard.</summary>
      <name>The Prisoner</name>
      <parts>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The cell door was open before you knew what you were doing. Now you are out, in borrowed clothes, with nothing in your hands.\n\nThe guard who watched you is still out there, and he is not going to let this go.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
    <modExtensions>
      <li Class="JustStart.JustStartScenarioExtension">
        <preferredPlayerFactions>
          <li>VFED_NewSafehaven</li>
          <li>Ferny_Spacers</li>
        </preferredPlayerFactions>
        <pawnRoles>
          <li>
            <id>prisoner</id>
            <count>1</count>
            <faction>PlayerColonist</faction>
            <useDefaultVanillaGear>false</useDefaultVanillaGear>
            <fixedEquipment>
              <Apparel_BasicShirt>1</Apparel_BasicShirt>
              <Apparel_Pants>1</Apparel_Pants>
            </fixedEquipment>
          </li>
          <li>
            <id>guard</id>
            <count>1</count>
            <faction>HostileOnMap</faction>
            <kindDef>Pirate</kindDef>
            <useDefaultVanillaGear>false</useDefaultVanillaGear>
            <fixedEquipment>
              <Apparel_BasicShirt>1</Apparel_BasicShirt>
              <Apparel_Pants>1</Apparel_Pants>
            </fixedEquipment>
            <weaponOptions>
              <MeleeWeapon_Club>1</MeleeWeapon_Club>
              <MeleeWeapon_Knife>1</MeleeWeapon_Knife>
            </weaponOptions>
            <spawnDistance>30~45</spawnDistance>
            <fightToTheDeath>true</fightToTheDeath>
            <canKidnap>false</canKidnap>
            <canSteal>false</canSteal>
            <canPickUpWeapons>false</canPickUpWeapons>
            <xenotypeRules>
              <mode>Fixed</mode>
              <xenotypes>
                <li MayRequire="Ludeon.RimWorld.Biotech">Baseliner</li>
              </xenotypes>
            </xenotypeRules>
          </li>
        </pawnRoles>
        <mapThings>
          <li>
            <options>
              <Gun_Revolver>1</Gun_Revolver>
              <Gun_Autopistol>1</Gun_Autopistol>
            </options>
            <distance>8~15</distance>
          </li>
        </mapThings>
      </li>
    </modExtensions>
  </ScenarioDef>

</Defs>
