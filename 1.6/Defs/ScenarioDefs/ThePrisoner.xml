<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!--
    The Prisoner - showcase for distinct pawn roles, non-colonist pawn spawning, and immediate
    hostile map entities (Section 13, Scenario 2). One prisoner (player faction, imprisoned),
    one guard (hostile, better equipped, spawns hostile on the starting map). Exact equipment
    is an illustrative default, not finalised design.
  -->
  <ScenarioDef>
    <defName>JustStart_ThePrisoner</defName>
    <label>The Prisoner</label>
    <description>You wake up in a cell. Someone is watching the door, and they are not on your side.</description>
    <scenario>
      <summary>JustStart_ThePrisoner</summary>
      <name>The Prisoner</name>
      <playerFaction>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
      </parts>
    </scenario>
    <modExtensions>
      <li Class="JustStart.JustStartScenarioExtension">
        <pawnRoles>
          <li>
            <id>prisoner</id>
            <count>1</count>
            <faction>PlayerPrisoner</faction>
            <kindDef>Colonist</kindDef>
            <useDefaultVanillaGear>false</useDefaultVanillaGear>
            <fixedEquipment />
          </li>
          <li>
            <id>guard</id>
            <count>1</count>
            <faction>HostileOnMap</faction>
            <kindDef>Pirate</kindDef>
            <useDefaultVanillaGear>false</useDefaultVanillaGear>
            <fixedEquipment>
              <li>
                <thingDef>Gun_PumpShotgun</thingDef>
                <count>1</count>
              </li>
              <li>
                <thingDef>Apparel_FlakJacket</thingDef>
                <count>1</count>
              </li>
              <li>
                <thingDef>Apparel_FlakVest</thingDef>
                <count>1</count>
              </li>
            </fixedEquipment>
          </li>
        </pawnRoles>
      </li>
    </modExtensions>
  </ScenarioDef>

</Defs>
