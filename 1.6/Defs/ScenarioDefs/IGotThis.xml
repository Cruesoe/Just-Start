<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!--
    I Got This - the ultimate challenge (Section 13, Scenario 3). One pawn, one pistol,
    forced Sea Ice start. Demonstrates an exact biome restriction plus a minimal/fixed loadout.
  -->
  <ScenarioDef>
    <defName>JustStart_IGotThis</defName>
    <label>I Got This</label>
    <description>One person. One pistol. The ice does not care.</description>
    <scenario>
      <summary>JustStart_IGotThis</summary>
      <name>I Got This</name>
      <playerFaction>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
      </parts>
    </scenario>
    <modExtensions>
      <li Class="JustStart.JustStartScenarioExtension">
        <tileConstraints>
          <li Class="JustStart.TileConstraint_Biome">
            <allowedBiomes>
              <li>SeaIce</li>
            </allowedBiomes>
          </li>
        </tileConstraints>
        <pawnRoles>
          <li>
            <id>lone_survivor</id>
            <count>1</count>
            <faction>PlayerColonist</faction>
            <useDefaultVanillaGear>false</useDefaultVanillaGear>
            <fixedEquipment>
              <li>
                <thingDef>Gun_Revolver</thingDef>
                <count>1</count>
              </li>
            </fixedEquipment>
          </li>
        </pawnRoles>
      </li>
    </modExtensions>
  </ScenarioDef>

</Defs>
